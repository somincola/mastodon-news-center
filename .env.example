# ============================================
# Mastodon News Center - 环境变量配置示例
# ============================================
# 
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 根据实际环境修改配置值
#   3. 生产环境必须设置强密码！
#
# ⚠️ 安全提示：
#   - .env 文件包含敏感信息，不要提交到 Git
#   - 生产环境必须修改所有默认密码
#   - 定期轮换密码和密钥
#
# ============================================

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 数据库连接配置

# 数据库用户名
POSTGRES_USER=mastodon_news

# 数据库密码（⚠️ 生产环境必须使用强密码！）
# 生成强密码：openssl rand -base64 32
POSTGRES_PASSWORD=changeme_in_production

# 数据库名称
POSTGRES_DB=mastodon_news

# 数据库端口（仅开发环境使用，生产环境不暴露）
# 开发环境：暴露到宿主机，方便使用数据库工具
# 生产环境：不暴露，仅内部网络访问
POSTGRES_PORT=5432

# 数据库连接 URL（自动构建，通常不需要手动修改）
# 格式：postgresql://用户名:密码@db:5432/数据库名
DATABASE_URL=postgresql://mastodon_news:changeme_in_production@db:5432/mastodon_news

# ============================================
# 应用配置
# ============================================
# 应用服务端口配置

# 应用端口（默认 8000）
# 开发环境：直接访问 http://localhost:8000
# 生产环境：通常通过 Nginx 反向代理，端口可自定义
APP_PORT=8000

# ============================================
# Mastodon 配置
# ============================================
# Mastodon 实例相关配置

# Mastodon 实例基础 URL
# 示例：https://m.somincola.org
# 用于构建帖子链接和 API 调用
MASTODON_BASE_URL=https://your-instance.com

# Mastodon 帖子最大字符数
# 默认：500（标准 Mastodon 限制）
# 可根据你的 Mastodon 实例的限制调整
MASTODON_MAX_LENGTH=500

# ============================================
# OpenAI 配置（可选）
# ============================================
# 如需使用 AI 摘要功能，请填写 OpenAI API Key

# OpenAI API Key
# 格式：sk-...
# 留空则不使用 AI 摘要功能
OPENAI_API_KEY=

# ============================================
# 管理员认证配置
# ============================================
# 后台管理系统的登录密码

# 管理员密码（默认: 123456）
# ⚠️ 生产环境强烈建议修改为强密码！
# 生成强密码：openssl rand -base64 32
# 不设置或留空将使用默认值 123456
ADMIN_PASSWORD=123456

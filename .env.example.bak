# Database Configuration
# ⚠️ 警告：生产环境请务必修改以下密码为强密码！
POSTGRES_USER=somincola
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=somincola_news
POSTGRES_PORT=5432
DATABASE_URL=postgresql://somincola:your_strong_password_here@localhost:5432/somincola_news

# Application Configuration
APP_PORT=8000

# Mastodon Configuration
# 配置你的 Mastodon 实例地址
MASTODON_BASE_URL=https://m.somincola.org
# Mastodon 帖子最大字符数（默认 500，标准 Mastodon 限制）
# 可根据你的 Mastodon 实例的限制调整此值
MASTODON_MAX_LENGTH=500

# OpenAI Configuration (Optional)
# 如需使用 AI 摘要功能，请填写你的 OpenAI API Key
OPENAI_API_KEY=

# Admin Authentication
# ⚠️ 生产环境必须设置管理员密码！
# 不设置密码将允许所有访问（仅用于开发环境）
# 生成强密码方法：openssl rand -base64 32
ADMIN_PASSWORD=123456
